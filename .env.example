# Set to true to run without a live Supabase project (local file store).
NEXT_PUBLIC_DEMO_MODE=true

# Required when NEXT_PUBLIC_DEMO_MODE is not true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed for superadmin staff invites in live mode.
SUPABASE_SERVICE_ROLE_KEY=
